# Copy to .env and fill in to enable LIVE Jira mode.
# Without these, the app serves the bundled snapshot (server/data/snapshot.json).

# Your Atlassian account email
JIRA_EMAIL=

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Optional overrides (defaults shown)
# JIRA_BASE_URL=https://celigo.atlassian.net
# IOTA_TEAM_ID=827e555d-3cbc-4be4-a2d4-595a7b3ba5ef-1031
# STORY_POINTS_FIELD=customfield_10102
# SPRINT_FIELD=customfield_10105
# TEAM_FIELD=customfield_12000
# PORT=4600
# CACHE_TTL_MS=300000
